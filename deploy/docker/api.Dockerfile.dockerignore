# keep local state and secrets out of the image
.git/
.venv/
**/__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# secrets, never in an image
.env
.env.*
!.env.example

# runtime data lives on volumes
data/
experiments/results/
experiments/checkpoints/

# private agent notes
.agent-vault/

# the frontend stage runs npm ci itself; host copies would overwrite it
frontend/node_modules/
frontend/dist/

# not needed at runtime
tests/
docs/
.github/

**/._*
**/.env
**/.env.*
!**/.env.example

# keep local state and secrets out of the image
.git/
.venv/
**/__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# secrets, never in an image
.env
.env.*
!.env.example

# runtime data lives on volumes
data/
experiments/results/
experiments/checkpoints/

# private agent notes
.agent-vault/

# not needed at runtime
tests/
docs/
.github/
web/node_modules/
web/.next/

**/._*
**/.env
**/.env.*
!**/.env.example

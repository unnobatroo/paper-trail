# separate random hex secrets each (openssl rand -hex 32), never commit the filled-in .env
DB_PASSWORD=
API_DB_PASSWORD=
WORKER_DB_PASSWORD=
REVIEW_KEY=
SEARXNG_SECRET=
ACME_EMAIL=
DOMAIN=
# extra evidence domains, prefer `python -m paper_trail.maintenance source add`
ALLOWED_DOMAINS=
BACKUP_DIR=/srv/paper-trail/backups
# huspacy 3.8.1 pinned to an immutable hf revision + sha256
HUSPACY_MODEL_URL=https://huggingface.co/huspacy/hu_core_news_lg/resolve/9160ba69dbbcfe1a2346f3c7c2d72831f8250219/hu_core_news_lg-3.8.1-py3-none-any.whl#sha256=e8cd6a5478419a8cdf3af1c3e3447565a49b8c60228acf76fdbd4c5ae3611cf1


# goethe on the host serves every model. key: goethe key --create paper-trail --rpm 0 --raw
GOETHE_API_KEY=
GOETHE_CERT=/home/<user>/.goethe/nginx/certs/server.crt

# Where the FastAPI backend listens.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Only for private deployments whose API sets PAPER_TRAIL_REVIEW_KEY:
# bakes the shared review key into the JS bundle, so it is readable by
# anyone who can load the site. Leave unset on a public UI — reviewers
# type the key into the sidebar dialog instead and it stays in their
# browser's localStorage.
NEXT_PUBLIC_REVIEW_KEY=

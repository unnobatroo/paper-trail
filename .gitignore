# Python environment, bytecode and build output
.venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
/build/
/dist/

# Test, lint and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# OS/editor leftovers and temporary output
.DS_Store
._*
*.bak
*.tmp
*.swp
*.swo
*~
*.log

# Local credentials; keep example configuration available
.env
.env.*
!.env.example
!.env.*.example
.streamlit/secrets.toml
.streamlit/secrets.*.toml
!.streamlit/secrets.example.toml

# Runtime data and downloaded models — nothing under data/ is source;
# documents and benchmark files sync via scripts/push_data.py / pull_data.py
data/processed/
data/fixtures/
data/source_documents/
data/benchmark/
data/models/
experiments/checkpoints/
experiments/results/

# Supabase CLI local state (not migrations)
supabase/.temp/
supabase/.branches/

# Local agent state
.agent-vault/

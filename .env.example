# local dev settings, copy to .env. every var is explained on the wiki (Reference),
# prod lives in deploy/zakazserver/.env.example

PAPER_TRAIL_API_ORIGINS=http://localhost:3000

# default embedder is a local ~220mb multilingual model, downloads once into data/models/.
# "hashing" = offline stub (results are noise), "openai:<model>" = any openai-style server.
# vectors are cached per model name, switching models = re-embed. max 1024 dims (pgvector)
PAPER_TRAIL_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
#   PAPER_TRAIL_EMBED_MODEL=openai:Qwen/Qwen3-Embedding-0.6B
#   PAPER_TRAIL_EMBED_BASE_URL=https://localhost:18443/v1   (goethe over an ssh tunnel)
PAPER_TRAIL_EMBED_BASE_URL=
PAPER_TRAIL_EMBED_API_KEY=
# goethe self-signs, point this at its cert for verified https
PAPER_TRAIL_MODEL_CA_BUNDLE=

# llm extraction on top of the rules, any openai-style chat endpoint. unset = rules only
#   PAPER_TRAIL_LLM_BASE_URL=https://localhost:18443/v1
#   PAPER_TRAIL_LLM_MODEL=unnobatroo/paper-trail-qwen3-4b-instruct-hu-awq
PAPER_TRAIL_LLM_BASE_URL=
PAPER_TRAIL_LLM_API_KEY=
PAPER_TRAIL_LLM_MODEL=
# pages per call, 1 for small models
PAPER_TRAIL_LLM_WINDOW=4

# "none" or "goethe" (any /rerank server at PAPER_TRAIL_RERANK_BASE_URL)
PAPER_TRAIL_RERANKER=none
PAPER_TRAIL_RERANK_BASE_URL=
PAPER_TRAIL_RERANK_MODEL=paper-trail/bge-reranker-v2-m3-bf16

# optional machine translation in the ui (hf inference api), unset hides the toggle
HF_TOKEN=

# badge in the ui, e.g. the municipality you track
PAPER_TRAIL_DEPLOYMENT=

# language profile for the rules (ml/lang.py), must match the tsvector regconfig
PAPER_TRAIL_LANGUAGE=hu
# extra evidence domains on top of the source registry, usually empty
PAPER_TRAIL_ALLOWED_DOMAINS=

# shared secret for every write, empty = open review (fine locally)
PAPER_TRAIL_REVIEW_KEY=

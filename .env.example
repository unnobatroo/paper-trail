# Cloud backend — when both are set the app stores ALL state in
# Supabase/Postgres: domain rows, fetched pages, chunk embeddings
# (pgvector) and source PDFs (Storage). Without them everything falls
# back to local SQLite + files under data/.
# Run supabase/migrations/001_schema.sql, 002_pgvector.sql and
# 003_jobs.sql once, then: uv run python scripts/push_data.py
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_KEY=<service_role key — stays server-side, never in the browser>
PAPER_TRAIL_STORAGE_BUCKET=source-documents

# CORS origins for the REST API (comma-separated; the frontend origin)
PAPER_TRAIL_API_ORIGINS=http://localhost:3000

# Hosted inference — no local model downloads. Without JINA_API_KEY the
# app uses fastembed's local ONNX models (open source, ~2 GB download).
PAPER_TRAIL_EMBED_MODEL=jina
PAPER_TRAIL_RERANKER=jina
JINA_API_KEY=<from jina.ai — free tier covers the demo>

# Hungarian → English machine translation in the UI
# (Helsinki-NLP/opus-mt-hu-en on the HF Inference API).
HF_TOKEN=<huggingface.co access token>

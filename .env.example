# Where the data lives. Set both of these and everything — domain rows,
# fetched pages, chunk embeddings, source PDFs — goes to Supabase instead
# of local SQLite + files under data/. Run the files in
# supabase/migrations/ once in the SQL editor, then:
#   uv run python scripts/push_data.py
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_KEY=<service_role key — server-side only, never in the browser>
PAPER_TRAIL_STORAGE_BUCKET=source-documents

# Which sites the API will serve requests from (comma-separated).
PAPER_TRAIL_API_ORIGINS=http://localhost:3000

# Models. The defaults are local and free: a multilingual MiniLM embedder
# (~220 MB, downloads once into data/models/) and no reranker.
#   hashing  — offline stub for tests; fast but the results are noise
#   jina     — hosted inference via JINA_API_KEY, nothing to download
PAPER_TRAIL_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# "auto" (the default upstream) uses the hosted Jina reranker when
# JINA_API_KEY is set and falls back to embedding-only otherwise — it's
# the cheap option for small hosts. "none" disables reranking outright;
# a local model name opts into downloading it (~1 GB).
PAPER_TRAIL_RERANKER=none
JINA_API_KEY=

# Optional source-language → English machine translation in the UI, via
# the Hugging Face Inference API. Leave unset and the toggle hides. The
# model defaults to opus-mt-<PAPER_TRAIL_LANGUAGE>-en; override with
# PAPER_TRAIL_MT_MODEL if a deployment needs a different one.
HF_TOKEN=

# Display name for this deployment (shown as a badge in the UI). e.g. the
# municipality or project the instance tracks. Empty = no badge.
PAPER_TRAIL_DEPLOYMENT=

# Language profile for the deterministic parsers — money/date/status
# cues, stemming, document labels. Profiles live in ml/lang.py; the
# tsvector column in migration 006 must match (regconfig). "hu" is the
# current corpus's profile; "en" is the generic baseline.
PAPER_TRAIL_LANGUAGE=hu
# Extra evidence domains on top of the official_sources registry hosts
# (comma-separated, subdomains included). Empty = registry only.
PAPER_TRAIL_ALLOWED_DOMAINS=
